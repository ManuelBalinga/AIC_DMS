# Copy to .env and fill in. .env is gitignored.

# Required. The agent will not run without it.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Any provider:model string LangChain's init_chat_model accepts —
# openai:gpt-5.5, google_genai:gemini-3.5-flash — given that provider's package
# and key. Defaults to anthropic:claude-sonnet-5.
# DEEP_AGENT_MODEL=anthropic:claude-sonnet-5

# Optional. Tracing to LangSmith. Note the EU endpoint: the SDK defaults to the
# US API, so an EU-region org gets no traces without this line.
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_ENDPOINT=https://eu.api.smith.langchain.com
# LANGSMITH_PROJECT=aic-deep-agent
