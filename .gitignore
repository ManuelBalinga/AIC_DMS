# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...except the template, which documents every variable the app needs
# and holds only placeholders. README and DEPLOYMENT.md both point at it.
!.env.example

# supabase cli scratch
supabase/.temp

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# database exports
# scripts/db-export.mjs reads with the service-role key, so its output is every
# document, question and answer in the platform, in plaintext. Never commit it.
/db/export/
