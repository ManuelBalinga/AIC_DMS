# Copy to .env.local and fill in from your Supabase project settings.
# Project Settings -> API Keys
#
# Supabase renamed these in 2026 and the dashboard now shows the new names, so
# a new project will not have anything literally labelled "anon key":
#
#   dashboard "Publishable key" (sb_publishable_...) -> NEXT_PUBLIC_SUPABASE_ANON_KEY
#   dashboard "Secret key"      (sb_secret_...)      -> SUPABASE_SERVICE_ROLE_KEY
#
# The variable names below keep the old wording because that is what the
# Supabase client library still calls them. Either generation of key works; the
# legacy anon/service_role pair is deprecated at the end of 2026, so a new
# project should use the publishable/secret pair.

# Safe to expose to the browser. Dashboard: "Publishable key".
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-key

# Used for invitation emails and auth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Direct Postgres connection, for `npm run db:migrate`.
# Dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the session pooler or the direct connection; the transaction pooler cannot
# run DDL. Contains the database password, so it never leaves .env.local.
SUPABASE_DB_URL=

# SERVER ONLY. Dashboard: "Secret key". Bypasses Row Level Security entirely.
# Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=your-secret-key

# --- AI / RAG (optional) ---------------------------------------------------
# Without these the platform works normally; only the Ask page degrades to
# keyword search, and uploads are stored but not indexed.

# Answer generation. Defaults to Anthropic; `openai-compatible` uses the generic
# variables below. Never put real values in this template.
# ANSWER_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# ANSWER_BASE_URL=
# ANSWER_API_KEY=

# Optional. Which Claude model answers questions. Defaults to claude-opus-5.
# Safe to change at any time — nothing generated by it is stored, so switching
# tiers needs no re-index. Unlike the embedding model, which is fixed once the
# corpus is indexed.
#   claude-haiku-4-5   cheapest and fastest; good for iterating
#   claude-sonnet-5    middle
#   claude-opus-5      default; best at declining to answer when the passages
#                      do not cover the question, which is the failure that
#                      matters most here
# ANSWER_MODEL=claude-opus-5

# Embeddings. Anthropic has no embedding endpoint, so retrieval uses a second
# vendor. text-embedding-3-small is 1536-wide, matching the vector column in
# migration 0001 -- changing model means changing that column.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_API_KEY=
# For `ollama` or `openai-compatible` providers:
# EMBEDDING_BASE_URL=
# EMBEDDING_API_KEY=
# Set only for providers that reject the dimensions parameter.
# EMBEDDING_OMIT_DIMENSIONS=false

# --- Database portability (optional) ---------------------------------------
# Only needed when moving records between providers. See db/README.md.
#
# Target for `node scripts/db-import.mjs --target neon`.
NEON_DATABASE_URL=

# Target for `node scripts/db-import.mjs --target supabase`. Named TARGET_ so an
# import can never be pointed at the project it was exported from by leaving a
# variable set.
TARGET_SUPABASE_URL=
TARGET_SUPABASE_SERVICE_ROLE_KEY=
